<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dto="using:WMSApp.DTO"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
             xmlns:vm="using:WMSApp.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="914"
             d:DesignWidth="411"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             x:Class="WMSApp.Views.PickingCodeView"
             x:DataType="vm:PickingCodeViewModel">
    <Design.DataContext>
        <vm:PickingCodeViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        <!-- 查询与主操作区 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="8">
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     Margin="0,0,8,0"
                     KeyDown="SearchTextBox_OnClick"
                     Text="{Binding SearchText}"
                     Watermark="请输入领料单号" />

            <Button Grid.Column="1"
                    Margin="0,0,8,0"
                    Classes="Secondary"
                    Command="{Binding SearchCodeCommand}"
                    Theme="{StaticResource SolidButton}"
                    AutomationProperties.AccessibilityView="Raw">
                <Grid>
                    <TextBlock Text="查询条码"
                               IsVisible="{Binding !IsSearching}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />

                    <ProgressBar IsIndeterminate="True"
                                 Theme="{DynamicResource ProgressRing}"
                                 IsVisible="{Binding IsSearching}"
                                 Height="20"
                                 Width="20"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center" />
                </Grid>
            </Button>

            <Button Grid.Column="2"
                    Margin="0,0,8,0"
                    Classes="Warning"
                    Content="全部亮灯"
                    Command="{Binding AllLightCommand}"
                    Theme="{StaticResource SolidButton}"
                    AutomationProperties.AccessibilityView="Raw" />

            <Button Grid.Column="3"
                    Margin="0,0,8,0"
                    Classes="Success"
                    Content="拣货完成"
                    Command="{Binding CompletePickingCommand}"
                    Theme="{StaticResource SolidButton}"
                    AutomationProperties.AccessibilityView="Raw" />
        </Grid>

        <!-- 颜色选择与锁定状态 -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *">
            <WrapPanel Grid.Column="0" ItemSpacing="4" Margin="10,0">
                <Label Classes="Solid Grey"
                       Theme="{StaticResource TagLabel}"
                       Cursor="Hand">
                    <i:Interaction.Behaviors>
                        <ia:EventTriggerBehavior EventName="Tapped">
                            <ia:InvokeCommandAction Command="{Binding TagClickCommand}"
                                                    CommandParameter="Grey" />
                        </ia:EventTriggerBehavior>
                    </i:Interaction.Behaviors>
                    熄灯
                </Label>
                <Label Classes="Solid Red" Theme="{StaticResource TagLabel}" Cursor="Hand">
                    <i:Interaction.Behaviors>
                        <ia:EventTriggerBehavior EventName="Tapped">
                            <ia:InvokeCommandAction Command="{Binding TagClickCommand}"
                                                    CommandParameter="Red" />
                        </ia:EventTriggerBehavior>
                    </i:Interaction.Behaviors>
                    红色
                </Label>
                <Label Classes="Solid Green" Theme="{StaticResource TagLabel}" Cursor="Hand">
                    <i:Interaction.Behaviors>
                        <ia:EventTriggerBehavior EventName="Tapped">
                            <ia:InvokeCommandAction Command="{Binding TagClickCommand}"
                                                    CommandParameter="Green" />
                        </ia:EventTriggerBehavior>
                    </i:Interaction.Behaviors>
                    绿色
                </Label>
                <Label Classes="Solid Blue" Theme="{StaticResource TagLabel}" Cursor="Hand">
                    <i:Interaction.Behaviors>
                        <ia:EventTriggerBehavior EventName="Tapped">
                            <ia:InvokeCommandAction Command="{Binding TagClickCommand}"
                                                    CommandParameter="Blue" />
                        </ia:EventTriggerBehavior>
                    </i:Interaction.Behaviors>
                    蓝色
                </Label>
                <Label Classes="Solid Yellow" Theme="{StaticResource TagLabel}" Cursor="Hand">
                    <i:Interaction.Behaviors>
                        <ia:EventTriggerBehavior EventName="Tapped">
                            <ia:InvokeCommandAction Command="{Binding TagClickCommand}"
                                                    CommandParameter="Yellow" />
                        </ia:EventTriggerBehavior>
                    </i:Interaction.Behaviors>
                    黄色
                </Label>
                <Label Classes="Solid Pink" Theme="{StaticResource TagLabel}" Cursor="Hand">
                    <i:Interaction.Behaviors>
                        <ia:EventTriggerBehavior EventName="Tapped">
                            <ia:InvokeCommandAction Command="{Binding TagClickCommand}"
                                                    CommandParameter="Pink" />
                        </ia:EventTriggerBehavior>
                    </i:Interaction.Behaviors>
                    洋红
                </Label>
                <Label Classes="Solid Cyan" Theme="{StaticResource TagLabel}" Cursor="Hand">
                    <i:Interaction.Behaviors>
                        <ia:EventTriggerBehavior EventName="Tapped">
                            <ia:InvokeCommandAction Command="{Binding TagClickCommand}"
                                                    CommandParameter="Cyan" />
                        </ia:EventTriggerBehavior>
                    </i:Interaction.Behaviors>
                    青色
                </Label>
                <Label Classes="Solid White" Theme="{StaticResource TagLabel}" Cursor="Hand">
                    <i:Interaction.Behaviors>
                        <ia:EventTriggerBehavior EventName="Tapped">
                            <ia:InvokeCommandAction Command="{Binding TagClickCommand}"
                                                    CommandParameter="White" />
                        </ia:EventTriggerBehavior>
                    </i:Interaction.Behaviors>
                    白色
                </Label>
            </WrapPanel>

            <ToggleSwitch Grid.Column="1"
                          HorizontalAlignment="Right"
                          OnContent="锁定中"
                          OffContent="已解锁"
                          IsChecked="{Binding IsLocked}"
                          IsEnabled="False" />
        </Grid>

        <!-- 状态消息区 -->
        <Grid Grid.Row="2" Margin="8,0">
            <Border IsVisible="{Binding HasMessage}"
                    Padding="10,8"
                    Theme="{DynamicResource CardBorder}">
                <TextBlock Text="{Binding StatusDisplayText}"
                           TextWrapping="Wrap"
                           Classes="Tertiary" />
            </Border>
        </Grid>

        <!-- 查询结果列表 -->
        <DataGrid Grid.Row="3"
                  Margin="8"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  HeadersVisibility="All"
                  IsReadOnly="True"
                  ItemsSource="{Binding GridData}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="3*" x:DataType="dto:VariableItem" Header="条码">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="dto:VariableItem">
                            <SelectableTextBlock Margin="12,0"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding BarNo}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="2*" x:DataType="dto:VariableItem" Header="数量">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="dto:VariableItem">
                            <SelectableTextBlock Margin="12,0"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding BarQty}"
                                                 TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="3*" x:DataType="dto:VariableItem" Header="库位">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="dto:VariableItem">
                            <SelectableTextBlock Margin="12,0"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding BinNo}"
                                                 TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="2*" x:DataType="dto:VariableItem" Header="亮灯" SortMemberPath="Duration">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="dto:VariableItem">
                            <Button Content="亮灯"
                                    Classes="Warning"
                                    Command="{Binding DataContext.LightOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding BinNo}"
                                    Theme="{StaticResource OutlineButton}"
                                    AutomationProperties.AccessibilityView="Raw" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
